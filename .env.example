KIPNERTER_ENV=development
KIPNERTER_PUBLIC_HOST=kipnerter.com
KIPNERTER_ADMIN_HOST=scottjoyner.dev
KIPNERTER_API_HOST=api.kipnerter.com
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://kipnerter.com,https://scottjoyner.dev
# Private services should resolve over Tailscale; never commit credentials here.
ASSISTX_BASE_URL=
SOPHIA_BASE_URL=
LMSTUDIO_BASE_URL=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# OIDC identity via explicitly deployed Tailscale tsidp; fail closed if missing.
NEXTAUTH_URL=https://kipnerter.com
NEXTAUTH_SECRET=
TSIDP_ISSUER=
TSIDP_CLIENT_ID=
TSIDP_CLIENT_SECRET=
KIPNERTER_ALLOWED_EMAILS=
KIPNERTER_ALLOWED_TSIDP_SUBJECTS=
# Read-only upstream observer credentials; no admin or mutation grants.
HERMES_BASE_URL=
OPENCODE_BASE_URL=
FLEET_MONITOR_BASE_URL=
KIPNERTER_GATEWAY_TOKEN=
FLEET_MONITOR_TOKEN=
